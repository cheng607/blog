SERVER_PORT=9090
GIN_MODE=debug
DB_DSN=blog:your_password@tcp(127.0.0.1:3306)/blog?parseTime=true&loc=Asia%2FShanghai&charset=utf8mb4
UPLOAD_PATH=/www/wwwroot/rain/upload/
UPLOAD_URL_PREFIX=/upload/images/
CORS_ORIGINS=https://www.raincode.top,https://raincode.top,http://localhost:5173,http://127.0.0.1:5173

# 阿里百炼 / DashScope（AI 助手，勿提交真实 Key 到 Git）
DASHSCOPE_API_KEY=你的百炼API密钥
# 多个模型逗号分隔，前者失败会尝试后者
DASHSCOPE_MODEL=qwen-plus,qwen-turbo
# 北京地域默认即可；弗吉尼亚用 https://dashscope-us.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 管理员 Token（保护文章发布、标签管理等敏感接口，必须配置）
# 管理密钥仅配置在后端 ADMIN_TOKEN，前端不配置密钥。
ADMIN_TOKEN=请设置一串复杂随机字符串

# AI 保护：每IP滚动一分钟次数、全站并发、上海时区每日上游调用次数、单次最大输出tokens
# 错误请求不调用模型；失败和备用模型调用消耗每日次数；两条chat路由共用限制。
AI_RATE_PER_MINUTE=6
AI_MAX_CONCURRENT=3
AI_DAILY_LIMIT=500
AI_MAX_TOKENS=1024
# 仅信任本机反向代理。额外代理须填准确IP/CIDR，切勿设为0.0.0.0/0。
TRUSTED_PROXIES=127.0.0.1,::1
