# 示例：域名 www.raincode.top，请按实际路径修改 root 与证书

server {
    listen 80;
    server_name www.raincode.top raincode.top;

    # 前端静态资源（npm run build 后的 dist）
    root /www/wwwroot/rain/blog-front/dist;
    index index.html;

    # API 与静态资源须优先匹配，避免被 SPA 回退吞掉
    location /api/ {
        proxy_pass http://127.0.0.1:9090/;
        proxy_connect_timeout 5s;
        proxy_send_timeout 20s;
        proxy_read_timeout 85s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 12m;
    }

    # 上传图片（封面、编辑器插图）
    location /upload/images/ {
        proxy_pass http://127.0.0.1:9090/upload/images/;
        proxy_set_header Host $host;
        expires 30d;
    }

    # History 路由：除真实文件外均回退 index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
